rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // PRIMITIVE HELPERS
    // =========================================================================

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email == 'bienaodylan428@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidLat(val) {
      return val is number && val >= -90 && val <= 90;
    }

    function isValidLng(val) {
      return val is number && val >= -180 && val <= 180;
    }

    function isValidVehicleCategory(val) {
      return val in ['motorcycle', 'cargo_motorcycle', 'tricycle', 'cargo_van', 'commercial_van', 'truck'];
    }

    function isValidDeliveryStatus(val) {
      return val in [
        'pending', 'scheduled', 'driver_assigned', 'driver_approaching_pickup',
        'at_pickup', 'package_collected', 'in_transit', 'approaching_recipient',
        'arrived', 'delivered', 'failed', 'rescheduled', 'cancelled'
      ];
    }

    // =========================================================================
    // ENTITY VALIDATION BLUEPRINTS (Anti-Update-Gap)
    // =========================================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'role', 'businessId', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isValidString(data.email, 3, 200)
        && isValidString(data.displayName, 1, 120)
        && isValidOptionalString(data, 'phone', 40)
        && isValidOptionalString(data, 'businessId', 128)
        && data.role in [
          'merchant', 'business_owner', 'business_employee',
          'independent_driver', 'rova_driver', 'fleet_partner',
          'fleet_manager', 'recipient', 'dispatcher',
          'operations_manager', 'admin', 'super_admin'
        ]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isSelfAllowedRole(role) {
      return role in ['merchant', 'business_owner', 'independent_driver', 'fleet_partner', 'recipient'];
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'level', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'level', 'createdAt'])
        && isValidId(data.uid)
        && isValidString(data.email, 3, 200)
        && data.level in ['dispatcher', 'operations_manager', 'admin', 'super_admin']
        && data.createdAt is timestamp;
    }

    function isValidBusiness(data) {
      return data.keys().hasAll(['ownerId', 'name', 'city', 'country', 'currency', 'verificationStatus', 'walletBalance', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'name', 'industry', 'city', 'country', 'currency',
          'verificationStatus', 'walletBalance', 'defaultPickupAddress',
          'defaultPickupLandmark', 'defaultPickupDigitalAddress',
          'defaultPickupLat', 'defaultPickupLng', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && isValidString(data.name, 1, 160)
        && isValidOptionalString(data, 'industry', 80)
        && isValidString(data.city, 1, 100)
        && isValidString(data.country, 1, 80)
        && isValidString(data.currency, 3, 8)
        && data.verificationStatus in ['pending', 'verified', 'suspended']
        && data.walletBalance is number && data.walletBalance >= 0
        && isValidOptionalString(data, 'defaultPickupAddress', 300)
        && isValidOptionalString(data, 'defaultPickupLandmark', 200)
        && isValidOptionalString(data, 'defaultPickupDigitalAddress', 60)
        && (!('defaultPickupLat' in data) || isValidLat(data.defaultPickupLat))
        && (!('defaultPickupLng' in data) || isValidLng(data.defaultPickupLng))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBusinessMember(data) {
      return data.keys().hasAll(['ownerId', 'email', 'name', 'memberRole', 'status', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'email', 'name', 'memberRole', 'status', 'createdAt'])
        && isValidId(data.ownerId)
        && isValidString(data.email, 3, 200)
        && isValidString(data.name, 1, 120)
        && data.memberRole in ['owner', 'manager', 'employee']
        && data.status in ['invited', 'active', 'revoked']
        && data.createdAt is timestamp;
    }

    function isValidSavedRecipient(data) {
      return data.keys().hasAll(['ownerId', 'name', 'phone', 'address', 'lat', 'lng', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'name', 'phone', 'address', 'landmark', 'digitalAddress', 'instructions', 'lat', 'lng', 'createdAt'])
        && isValidId(data.ownerId)
        && isValidString(data.name, 1, 120)
        && isValidString(data.phone, 3, 40)
        && isValidString(data.address, 1, 300)
        && isValidOptionalString(data, 'landmark', 200)
        && isValidOptionalString(data, 'digitalAddress', 60)
        && isValidOptionalString(data, 'instructions', 300)
        && isValidLat(data.lat)
        && isValidLng(data.lng)
        && data.createdAt is timestamp;
    }

    function isValidDriver(data) {
      return data.keys().hasAll([
          'uid', 'fullName', 'phone', 'partnerType', 'vehicleCategory',
          'vehiclePlate', 'licenseNumber', 'serviceArea', 'approvalStatus',
          'isOnline', 'rating', 'completedDeliveries', 'acceptanceRate',
          'earningsTotal', 'activeDeliveryCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'fullName', 'phone', 'partnerType', 'vehicleCategory',
          'vehiclePlate', 'licenseNumber', 'insuranceRef', 'serviceArea',
          'approvalStatus', 'isOnline', 'currentLat', 'currentLng',
          'rating', 'completedDeliveries', 'acceptanceRate',
          'earningsTotal', 'activeDeliveryCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && isValidString(data.fullName, 1, 120)
        && isValidString(data.phone, 3, 40)
        && data.partnerType in ['independent', 'rova_fleet', 'fleet_partner', 'commercial_partner']
        && isValidVehicleCategory(data.vehicleCategory)
        && isValidString(data.vehiclePlate, 2, 40)
        && isValidString(data.licenseNumber, 2, 80)
        && isValidOptionalString(data, 'insuranceRef', 120)
        && isValidString(data.serviceArea, 1, 120)
        && data.approvalStatus in ['pending', 'under_review', 'approved', 'suspended']
        && data.isOnline is bool
        && (!('currentLat' in data) || isValidLat(data.currentLat))
        && (!('currentLng' in data) || isValidLng(data.currentLng))
        && data.rating is number && data.rating >= 0 && data.rating <= 5
        && data.completedDeliveries is number && data.completedDeliveries >= 0
        && data.acceptanceRate is number && data.acceptanceRate >= 0 && data.acceptanceRate <= 100
        && data.earningsTotal is number && data.earningsTotal >= 0
        && data.activeDeliveryCount is number && data.activeDeliveryCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDriverDispatch(data) {
      return data.keys().hasAll([
          'uid', 'firstName', 'partnerType', 'vehicleCategory', 'serviceArea',
          'approvalStatus', 'isOnline', 'currentLat', 'currentLng', 'rating',
          'completedDeliveries', 'acceptanceRate', 'activeDeliveryCount', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'firstName', 'partnerType', 'vehicleCategory', 'serviceArea',
          'approvalStatus', 'isOnline', 'currentLat', 'currentLng', 'rating',
          'completedDeliveries', 'acceptanceRate', 'activeDeliveryCount', 'updatedAt'
        ])
        && isValidId(data.uid)
        && isValidString(data.firstName, 1, 80)
        && data.partnerType in ['independent', 'rova_fleet', 'fleet_partner', 'commercial_partner']
        && isValidVehicleCategory(data.vehicleCategory)
        && isValidString(data.serviceArea, 1, 120)
        && data.approvalStatus in ['pending', 'under_review', 'approved', 'suspended']
        && data.isOnline is bool
        && isValidLat(data.currentLat)
        && isValidLng(data.currentLng)
        && data.rating is number && data.rating >= 0 && data.rating <= 5
        && data.completedDeliveries is number && data.completedDeliveries >= 0
        && data.acceptanceRate is number && data.acceptanceRate >= 0 && data.acceptanceRate <= 100
        && data.activeDeliveryCount is number && data.activeDeliveryCount >= 0
        && data.updatedAt is timestamp;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll([
          'fleetNumber', 'registration', 'category', 'ownerType', 'capacityKg',
          'status', 'serviceArea', 'maintenanceStatus', 'brandingStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'fleetNumber', 'registration', 'category', 'ownerType', 'partnerName',
          'assignedDriverId', 'capacityKg', 'status', 'serviceArea',
          'maintenanceStatus', 'insuranceExpiry', 'brandingStatus', 'createdAt', 'updatedAt'
        ])
        && isValidString(data.fleetNumber, 1, 40)
        && isValidString(data.registration, 2, 40)
        && isValidVehicleCategory(data.category)
        && data.ownerType in ['rova', 'partner', 'driver']
        && isValidOptionalString(data, 'partnerName', 120)
        && isValidOptionalString(data, 'assignedDriverId', 128)
        && data.capacityKg is number && data.capacityKg > 0 && data.capacityKg <= 50000
        && data.status in ['available', 'assigned', 'in_operation', 'reserved', 'maintenance', 'inactive', 'suspended']
        && isValidString(data.serviceArea, 1, 120)
        && data.maintenanceStatus in ['nominal', 'due_soon', 'in_service']
        && isValidOptionalString(data, 'insuranceExpiry', 40)
        && data.brandingStatus in ['branded', 'pending', 'unbranded']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEquipment(data) {
      return data.keys().hasAll(['name', 'category', 'totalStock', 'assignedCount', 'availableStock', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'category', 'size', 'totalStock', 'assignedCount', 'availableStock', 'createdAt', 'updatedAt'])
        && isValidString(data.name, 1, 120)
        && data.category in ['uniform', 'jacket', 'shirt', 'helmet', 'bag', 'delivery_box', 'reflective_vest', 'phone_holder', 'id_card', 'sticker', 'vehicle_branding', 'accessory']
        && isValidOptionalString(data, 'size', 20)
        && data.totalStock is number && data.totalStock >= 0
        && data.assignedCount is number && data.assignedCount >= 0
        && data.availableStock is number && data.availableStock >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEquipmentAssignment(data) {
      return data.keys().hasAll(['equipmentId', 'equipmentName', 'driverId', 'driverName', 'quantity', 'status', 'assignedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['equipmentId', 'equipmentName', 'driverId', 'driverName', 'quantity', 'size', 'status', 'assignedBy', 'createdAt', 'updatedAt'])
        && isValidId(data.equipmentId)
        && isValidString(data.equipmentName, 1, 120)
        && isValidId(data.driverId)
        && isValidString(data.driverName, 1, 120)
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 100
        && isValidOptionalString(data, 'size', 20)
        && data.status in ['assigned', 'returned', 'replaced']
        && isValidId(data.assignedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPartner(data) {
      return data.keys().hasAll([
          'companyName', 'contactName', 'contactEmail', 'contactPhone',
          'partnerType', 'status', 'serviceArea', 'commissionRate',
          'vehicleCount', 'driverCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'companyName', 'contactName', 'contactEmail', 'contactPhone',
          'partnerType', 'status', 'serviceArea', 'commissionRate',
          'paymentTerms', 'vehicleCount', 'driverCount', 'contractRef',
          'createdAt', 'updatedAt'
        ])
        && isValidString(data.companyName, 1, 160)
        && isValidString(data.contactName, 1, 120)
        && isValidString(data.contactEmail, 3, 200)
        && isValidString(data.contactPhone, 3, 40)
        && data.partnerType in ['fleet_partner', 'transport_provider', 'delivery_partner', 'corporate_client', 'warehouse', 'fulfillment']
        && data.status in ['pending', 'active', 'suspended', 'terminated']
        && isValidString(data.serviceArea, 1, 120)
        && data.commissionRate is number && data.commissionRate >= 0 && data.commissionRate <= 100
        && isValidOptionalString(data, 'paymentTerms', 80)
        && data.vehicleCount is number && data.vehicleCount >= 0
        && data.driverCount is number && data.driverCount >= 0
        && isValidOptionalString(data, 'contractRef', 80)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDelivery(data) {
      return data.keys().hasAll([
          'reference', 'merchantUid', 'merchantName', 'driverUid', 'vehicleCategory',
          'timingType', 'pickupAddress', 'pickupLat', 'pickupLng',
          'packageType', 'packageSize', 'weightKg', 'quantity', 'fragile',
          'proofRequired', 'status', 'isMultiStop', 'stopCount', 'completedStopCount',
          'totalDistanceKm', 'estimatedDurationMin', 'quotedPrice', 'currency',
          'paymentMethod', 'paymentStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'reference', 'businessId', 'merchantUid', 'merchantName', 'driverUid', 'driverName',
          'vehicleCategory', 'timingType', 'scheduledFor',
          'pickupAddress', 'pickupLandmark', 'pickupDigitalAddress', 'pickupInstructions',
          'pickupLat', 'pickupLng', 'primaryDestinationLabel', 'stopIds',
          'packageType', 'packageSize', 'weightKg', 'quantity', 'fragile', 'specialHandling',
          'proofRequired', 'status', 'isMultiStop', 'stopCount', 'completedStopCount',
          'totalDistanceKm', 'estimatedDurationMin', 'quotedPrice', 'currency',
          'paymentMethod', 'paymentStatus', 'driverLat', 'driverLng',
          'createdAt', 'updatedAt'
        ])
        && isValidString(data.reference, 4, 40)
        && isValidOptionalString(data, 'businessId', 128)
        && isValidId(data.merchantUid)
        && isValidString(data.merchantName, 1, 160)
        && data.driverUid is string && data.driverUid.size() <= 128
        && isValidOptionalString(data, 'driverName', 120)
        && isValidVehicleCategory(data.vehicleCategory)
        && data.timingType in ['instant', 'scheduled', 'driver_reservation', 'vehicle_reservation', 'full_day']
        && isValidOptionalString(data, 'scheduledFor', 60)
        && isValidString(data.pickupAddress, 1, 300)
        && isValidOptionalString(data, 'pickupLandmark', 200)
        && isValidOptionalString(data, 'pickupDigitalAddress', 60)
        && isValidOptionalString(data, 'pickupInstructions', 300)
        && isValidLat(data.pickupLat)
        && isValidLng(data.pickupLng)
        && isValidOptionalString(data, 'primaryDestinationLabel', 240)
        && (!('stopIds' in data) || (data.stopIds is list && data.stopIds.size() >= 1 && data.stopIds.size() <= 50 && data.stopIds[0] is string && data.stopIds[0].size() <= 128))
        && isValidString(data.packageType, 1, 80)
        && data.packageSize in ['small', 'medium', 'large', 'bulk']
        && data.weightKg is number && data.weightKg > 0 && data.weightKg <= 50000
        && data.quantity is number && data.quantity >= 1 && data.quantity <= 1000
        && data.fragile is bool
        && isValidOptionalString(data, 'specialHandling', 240)
        && data.proofRequired in ['otp', 'pin', 'signature', 'photo', 'recipient_confirm']
        && isValidDeliveryStatus(data.status)
        && data.isMultiStop is bool
        && data.stopCount is number && data.stopCount >= 1 && data.stopCount <= 100
        && data.completedStopCount is number && data.completedStopCount >= 0 && data.completedStopCount <= 100
        && data.totalDistanceKm is number && data.totalDistanceKm >= 0
        && data.estimatedDurationMin is number && data.estimatedDurationMin >= 0
        && data.quotedPrice is number && data.quotedPrice >= 0
        && isValidString(data.currency, 3, 8)
        && data.paymentMethod in ['mobile_money', 'card', 'invoice', 'wallet']
        && data.paymentStatus in ['pending', 'authorized', 'paid', 'invoiced', 'refunded']
        && (!('driverLat' in data) || isValidLat(data.driverLat))
        && (!('driverLng' in data) || isValidLng(data.driverLng))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDeliveryStop(data) {
      return data.keys().hasAll([
          'deliveryId', 'merchantUid', 'driverUid', 'sequence',
          'recipientName', 'recipientPhone', 'address', 'lat', 'lng',
          'status', 'otpCode', 'trackingToken', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'deliveryId', 'merchantUid', 'driverUid', 'sequence',
          'recipientName', 'recipientPhone', 'address', 'landmark', 'digitalAddress',
          'instructions', 'lat', 'lng', 'packageRef', 'status',
          'otpCode', 'proofType', 'proofValue', 'proofNotes', 'trackingToken',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.deliveryId)
        && isValidId(data.merchantUid)
        && data.driverUid is string && data.driverUid.size() <= 128
        && data.sequence is number && data.sequence >= 1 && data.sequence <= 100
        && isValidString(data.recipientName, 1, 120)
        && isValidString(data.recipientPhone, 3, 40)
        && isValidString(data.address, 1, 300)
        && isValidOptionalString(data, 'landmark', 200)
        && isValidOptionalString(data, 'digitalAddress', 60)
        && isValidOptionalString(data, 'instructions', 300)
        && isValidLat(data.lat)
        && isValidLng(data.lng)
        && isValidOptionalString(data, 'packageRef', 80)
        && isValidDeliveryStatus(data.status)
        && isValidString(data.otpCode, 4, 10)
        && isValidOptionalString(data, 'proofType', 40)
        && isValidOptionalString(data, 'proofValue', 120000)
        && isValidOptionalString(data, 'proofNotes', 300)
        && isValidId(data.trackingToken)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicTracking(data) {
      return data.keys().hasAll([
          'trackingToken', 'deliveryId', 'stopId', 'merchantUid', 'driverUid',
          'reference', 'recipientFirstName', 'destinationLabel',
          'destinationLat', 'destinationLng', 'status', 'vehicleCategory',
          'showLiveDriver', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'trackingToken', 'deliveryId', 'stopId', 'merchantUid', 'driverUid',
          'reference', 'recipientFirstName', 'destinationLabel',
          'destinationLat', 'destinationLng', 'status', 'driverFirstName',
          'vehicleCategory', 'driverLat', 'driverLng', 'etaMinutes',
          'showLiveDriver', 'otpHint', 'updatedAt'
        ])
        && isValidId(data.trackingToken)
        && isValidId(data.deliveryId)
        && isValidId(data.stopId)
        && isValidId(data.merchantUid)
        && data.driverUid is string && data.driverUid.size() <= 128
        && isValidString(data.reference, 4, 40)
        && isValidString(data.recipientFirstName, 1, 80)
        && isValidString(data.destinationLabel, 1, 300)
        && isValidLat(data.destinationLat)
        && isValidLng(data.destinationLng)
        && isValidDeliveryStatus(data.status)
        && isValidOptionalString(data, 'driverFirstName', 80)
        && isValidVehicleCategory(data.vehicleCategory)
        && (!('driverLat' in data) || isValidLat(data.driverLat))
        && (!('driverLng' in data) || isValidLng(data.driverLng))
        && (!('etaMinutes' in data) || (data.etaMinutes is number && data.etaMinutes >= 0))
        && data.showLiveDriver is bool
        && isValidOptionalString(data, 'otpHint', 10)
        && data.updatedAt is timestamp;
    }

    function isValidReservation(data) {
      return data.keys().hasAll([
          'merchantUid', 'merchantName', 'vehicleCategory', 'driverUid',
          'reservationDate', 'startTime', 'endTime', 'durationType',
          'pickupAddress', 'pickupLat', 'pickupLng', 'quotedPrice',
          'currency', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'businessId', 'merchantUid', 'merchantName', 'vehicleId', 'vehicleCategory',
          'driverUid', 'reservationDate', 'startTime', 'endTime', 'durationType',
          'pickupAddress', 'pickupLat', 'pickupLng', 'destinationsSummary',
          'cargoRequirements', 'quotedPrice', 'currency', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidOptionalString(data, 'businessId', 128)
        && isValidId(data.merchantUid)
        && isValidString(data.merchantName, 1, 160)
        && isValidOptionalString(data, 'vehicleId', 128)
        && isValidVehicleCategory(data.vehicleCategory)
        && data.driverUid is string && data.driverUid.size() <= 128
        && isValidString(data.reservationDate, 8, 20)
        && isValidString(data.startTime, 4, 12)
        && isValidString(data.endTime, 4, 12)
        && data.durationType in ['window', 'hours', 'full_day']
        && isValidString(data.pickupAddress, 1, 300)
        && isValidLat(data.pickupLat)
        && isValidLng(data.pickupLng)
        && isValidOptionalString(data, 'destinationsSummary', 400)
        && isValidOptionalString(data, 'cargoRequirements', 300)
        && data.quotedPrice is number && data.quotedPrice >= 0
        && isValidString(data.currency, 3, 8)
        && data.status in ['pending_approval', 'confirmed', 'in_progress', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPricingRule(data) {
      return data.keys().hasAll([
          'zoneName', 'city', 'country', 'currency', 'vehicleCategory',
          'baseFee', 'perKmRate', 'minimumFare', 'scheduledFee',
          'cargoSurcharge', 'multiStopFee', 'priorityMultiplier',
          'peakMultiplier', 'fullDayRate', 'active', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'zoneName', 'city', 'country', 'currency', 'vehicleCategory',
          'baseFee', 'perKmRate', 'minimumFare', 'waitingFeePerMin', 'scheduledFee',
          'cargoSurcharge', 'multiStopFee', 'priorityMultiplier',
          'peakMultiplier', 'fullDayRate', 'active', 'updatedAt'
        ])
        && isValidString(data.zoneName, 1, 100)
        && isValidString(data.city, 1, 80)
        && isValidString(data.country, 1, 80)
        && isValidString(data.currency, 3, 8)
        && isValidVehicleCategory(data.vehicleCategory)
        && data.baseFee is number && data.baseFee >= 0
        && data.perKmRate is number && data.perKmRate >= 0
        && data.minimumFare is number && data.minimumFare >= 0
        && (!('waitingFeePerMin' in data) || (data.waitingFeePerMin is number && data.waitingFeePerMin >= 0))
        && data.scheduledFee is number && data.scheduledFee >= 0
        && data.cargoSurcharge is number && data.cargoSurcharge >= 0
        && data.multiStopFee is number && data.multiStopFee >= 0
        && data.priorityMultiplier is number && data.priorityMultiplier >= 1
        && data.peakMultiplier is number && data.peakMultiplier >= 1
        && data.fullDayRate is number && data.fullDayRate >= 0
        && data.active is bool
        && data.updatedAt is timestamp;
    }

    function isValidIncident(data) {
      return data.keys().hasAll(['reportedByUid', 'reporterRole', 'category', 'description', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['deliveryId', 'reportedByUid', 'reporterRole', 'category', 'description', 'status', 'resolutionNotes', 'createdAt', 'updatedAt'])
        && isValidOptionalString(data, 'deliveryId', 128)
        && isValidId(data.reportedByUid)
        && isValidString(data.reporterRole, 1, 40)
        && data.category in ['failed_delivery', 'damage', 'delay', 'dispute', 'refund', 'driver_report']
        && isValidString(data.description, 5, 1000)
        && data.status in ['open', 'investigating', 'resolved']
        && isValidOptionalString(data, 'resolutionNotes', 1000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'eventType', 'read', 'createdAt'])
        && data.keys().hasOnly(['userId', 'title', 'message', 'eventType', 'deliveryId', 'read', 'createdAt'])
        && isValidId(data.userId)
        && isValidString(data.title, 1, 140)
        && isValidString(data.message, 1, 400)
        && isValidString(data.eventType, 1, 60)
        && isValidOptionalString(data, 'deliveryId', 128)
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidWaitlist(data) {
      return data.keys().hasAll(['name', 'email', 'platform', 'createdAt'])
        && data.keys().hasOnly(['name', 'email', 'company', 'city', 'platform', 'message', 'createdAt'])
        && isValidString(data.name, 1, 120)
        && isValidString(data.email, 3, 200)
        && isValidOptionalString(data, 'company', 160)
        && isValidOptionalString(data, 'city', 100)
        && data.platform in ['ios', 'android', 'partner', 'driver', 'contact']
        && isValidOptionalString(data, 'message', 1000)
        && data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorEmail', 'action', 'entityType', 'entityId', 'summary', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorEmail', 'action', 'entityType', 'entityId', 'summary', 'createdAt'])
        && isValidId(data.actorUid)
        && isValidString(data.actorEmail, 3, 200)
        && isValidString(data.action, 1, 80)
        && isValidString(data.entityType, 1, 60)
        && isValidId(data.entityId)
        && isValidString(data.summary, 1, 400)
        && data.createdAt is timestamp;
    }

    // =========================================================================
    // COLLECTION RULES
    // =========================================================================

    // 1. Users (PII Strictly Isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrapAdmin();
      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isSelfAllowedRole(incoming().role) || isBootstrapAdmin());
      allow update: if isVerified() && isValidId(userId) && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'businessId', 'role', 'updatedAt'])
            && (incoming().role == existing().role || isSelfAllowedRole(incoming().role)))
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 2. Admins (Bootstrap Admin Managed)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrapAdmin();
      allow create: if isValidId(userId) && isBootstrapAdmin() && isValidAdmin(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(userId) && isBootstrapAdmin() && isValidAdmin(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(userId) && isBootstrapAdmin();
    }

    // 3. Businesses & Subcollections
    match /businesses/{businessId} {
      allow get: if isValidId(businessId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isBootstrapAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if isVerified() && isValidId(businessId) && isValidBusiness(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().verificationStatus == 'pending'
        && incoming().walletBalance == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(businessId) && isValidBusiness(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'industry', 'city', 'country', 'currency',
              'defaultPickupAddress', 'defaultPickupLandmark', 'defaultPickupDigitalAddress',
              'defaultPickupLat', 'defaultPickupLng', 'updatedAt'
            ]))
        );
      allow delete: if isValidId(businessId) && isAdmin();

      // Master Gate on Business Team Members
      match /members/{memberId} {
        allow get: if isValidId(businessId) && isValidId(memberId) && isSignedIn()
          && (get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (isBootstrapAdmin() || resource.data.ownerId == request.auth.uid);
        allow create: if isVerified() && isValidId(businessId) && isValidId(memberId)
          && isValidBusinessMember(incoming())
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/businesses/$(businessId))
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        allow update: if isVerified() && isValidId(businessId) && isValidId(memberId)
          && isValidBusinessMember(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && (isAdmin() || (
            get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberRole', 'status'])
          ));
        allow delete: if isVerified() && isValidId(businessId) && isValidId(memberId)
          && (isAdmin() || get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid);
      }

      // Master Gate on Saved Recipients
      match /recipients/{recipientId} {
        allow get: if isValidId(businessId) && isValidId(recipientId) && isSignedIn()
          && (get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (isBootstrapAdmin() || resource.data.ownerId == request.auth.uid);
        allow create: if isVerified() && isValidId(businessId) && isValidId(recipientId)
          && isValidSavedRecipient(incoming())
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/businesses/$(businessId))
          && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        allow update: if isVerified() && isValidId(businessId) && isValidId(recipientId)
          && isValidSavedRecipient(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && (isAdmin() || (
            get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'landmark', 'digitalAddress', 'instructions', 'lat', 'lng'])
          ));
        allow delete: if isVerified() && isValidId(businessId) && isValidId(recipientId)
          && (isAdmin() || get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid);
      }
    }

    // 4. Drivers (Private PII & Verification Docs — Owner or Admin Only)
    match /drivers/{driverId} {
      allow get: if isValidId(driverId) && isSignedIn() && (isOwner(driverId) || isAdmin());
      allow list: if isSignedIn() && (isBootstrapAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isVerified() && isValidId(driverId) && isOwner(driverId)
        && isValidDriver(incoming())
        && incoming().uid == request.auth.uid
        && incoming().approvalStatus == 'pending'
        && incoming().isOnline == false
        && incoming().rating == 5
        && incoming().completedDeliveries == 0
        && incoming().acceptanceRate == 100
        && incoming().earningsTotal == 0
        && incoming().activeDeliveryCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(driverId) && isValidDriver(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          // Driver can toggle online & update GPS only once approved (bounded stat deltas)
          (isOwner(driverId) && existing().approvalStatus == 'approved'
            && incoming().completedDeliveries >= existing().completedDeliveries
            && incoming().completedDeliveries <= existing().completedDeliveries + 1
            && incoming().earningsTotal >= existing().earningsTotal
            && incoming().earningsTotal <= existing().earningsTotal + 100000
            && incoming().diff(existing()).affectedKeys().hasOnly(['isOnline', 'currentLat', 'currentLng', 'activeDeliveryCount', 'completedDeliveries', 'earningsTotal', 'updatedAt'])) ||
          // Driver can edit profile/docs while pending
          (isOwner(driverId) && existing().approvalStatus in ['pending', 'under_review']
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'vehicleCategory', 'vehiclePlate', 'licenseNumber', 'insuranceRef', 'serviceArea', 'updatedAt']))
        );
      allow delete: if isValidId(driverId) && isAdmin();
    }

    // 5. Driver Dispatch Projection (PII-Free Nearby Matching Index)
    match /driverDispatch/{driverId} {
      allow get: if isValidId(driverId) && isSignedIn()
        && (isOwner(driverId) || isAdmin() || (existing().approvalStatus == 'approved' && existing().isOnline == true));
      allow list: if isSignedIn()
        && (isBootstrapAdmin() || resource.data.uid == request.auth.uid || (resource.data.approvalStatus == 'approved' && resource.data.isOnline == true));
      allow create: if isVerified() && isValidId(driverId) && (isOwner(driverId) || isAdmin())
        && isValidDriverDispatch(incoming())
        && incoming().uid == driverId
        && (isAdmin() || (incoming().approvalStatus == 'pending' && incoming().isOnline == false))
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(driverId) && isValidDriverDispatch(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isOwner(driverId) && existing().approvalStatus == 'approved'
            && incoming().diff(existing()).affectedKeys().hasOnly(['isOnline', 'currentLat', 'currentLng', 'activeDeliveryCount', 'completedDeliveries', 'updatedAt']))
        );
      allow delete: if isValidId(driverId) && isAdmin();
    }

    // 6. ROVA Fleet Vehicles
    match /vehicles/{vehicleId} {
      allow get: if isValidId(vehicleId) && isSignedIn();
      allow list: if isSignedIn() && (isBootstrapAdmin() || resource.data.status == 'available' || resource.data.assignedDriverId == request.auth.uid);
      allow create: if isValidId(vehicleId) && isAdmin() && isValidVehicle(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(vehicleId) && isAdmin() && isValidVehicle(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(vehicleId) && isAdmin();
    }

    // 7. Physical Brand Equipment Inventory
    match /equipment/{itemId} {
      allow get: if isValidId(itemId) && isAdmin();
      allow list: if isBootstrapAdmin();
      allow create: if isValidId(itemId) && isAdmin() && isValidEquipment(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(itemId) && isAdmin() && isValidEquipment(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(itemId) && isAdmin();
    }

    // 8. Equipment Assignments
    match /equipmentAssignments/{assignmentId} {
      allow get: if isValidId(assignmentId) && isSignedIn() && (existing().driverId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isBootstrapAdmin() || resource.data.driverId == request.auth.uid);
      allow create: if isValidId(assignmentId) && isAdmin() && isValidEquipmentAssignment(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(assignmentId) && isAdmin() && isValidEquipmentAssignment(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(assignmentId) && isAdmin();
    }

    // 9. Partnerships
    match /partners/{partnerId} {
      allow get: if isValidId(partnerId) && isAdmin();
      allow list: if isBootstrapAdmin();
      allow create: if isValidId(partnerId) && isAdmin() && isValidPartner(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(partnerId) && isAdmin() && isValidPartner(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(partnerId) && isAdmin();
    }

    // 10. Deliveries & Multi-Stop Routes
    match /deliveries/{deliveryId} {
      allow get: if isValidId(deliveryId) && isSignedIn()
        && (existing().merchantUid == request.auth.uid || existing().driverUid == request.auth.uid || (existing().status == 'pending' && existing().driverUid == '') || isAdmin());
      allow list: if isSignedIn()
        && (isBootstrapAdmin() || resource.data.merchantUid == request.auth.uid || resource.data.driverUid == request.auth.uid || (resource.data.status == 'pending' && resource.data.driverUid == ''));
      allow create: if isVerified() && isValidId(deliveryId) && isValidDelivery(incoming())
        && incoming().merchantUid == request.auth.uid
        && incoming().status in ['pending', 'scheduled', 'driver_assigned']
        && incoming().completedStopCount == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(deliveryId) && isValidDelivery(incoming())
        && incoming().merchantUid == existing().merchantUid
        && incoming().reference == existing().reference
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          // Terminal state locking for non-admins
          (!(existing().status in ['delivered', 'cancelled']) && (
            // Action: Merchant cancels pending/scheduled delivery or assigns matched driver
            (existing().merchantUid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'driverUid', 'driverName', 'updatedAt'])) ||
            // Action: Approved driver claims an unassigned pending delivery
            (existing().status == 'pending' && existing().driverUid == ''
              && incoming().driverUid == request.auth.uid
              && incoming().status == 'driver_assigned'
              && exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
              && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.approvalStatus == 'approved'
              && incoming().diff(existing()).affectedKeys().hasOnly(['driverUid', 'driverName', 'status', 'driverLat', 'driverLng', 'updatedAt'])) ||
            // Action: Assigned driver updates status, live GPS, and stop completion count
            (existing().driverUid == request.auth.uid
              && incoming().driverUid == existing().driverUid
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'driverLat', 'driverLng', 'completedStopCount', 'updatedAt']))
          ))
        );
      allow delete: if isValidId(deliveryId) && isAdmin();

      // Master Gate on Delivery Stops (Strict PII Isolation: unassigned drivers cannot read stops)
      match /stops/{stopId} {
        allow get: if isValidId(deliveryId) && isValidId(stopId) && isSignedIn()
          && (
            get(/databases/$(database)/documents/deliveries/$(deliveryId)).data.merchantUid == request.auth.uid
            || get(/databases/$(database)/documents/deliveries/$(deliveryId)).data.driverUid == request.auth.uid
            || isAdmin()
          );
        allow list: if isSignedIn()
          && (isBootstrapAdmin() || resource.data.merchantUid == request.auth.uid || resource.data.driverUid == request.auth.uid);
        allow create: if isVerified() && isValidId(deliveryId) && isValidId(stopId)
          && isValidDeliveryStop(incoming())
          && incoming().deliveryId == deliveryId
          && incoming().merchantUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/deliveries/$(deliveryId))
          && get(/databases/$(database)/documents/deliveries/$(deliveryId)).data.merchantUid == request.auth.uid;
        allow update: if isVerified() && isValidId(deliveryId) && isValidId(stopId)
          && isValidDeliveryStop(incoming())
          && incoming().deliveryId == existing().deliveryId
          && incoming().merchantUid == existing().merchantUid
          && incoming().trackingToken == existing().trackingToken
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (!(existing().status in ['delivered', 'cancelled']) && (
              // Merchant reorders or cancels stop or links assigned driver
              (existing().merchantUid == request.auth.uid
                && incoming().diff(existing()).affectedKeys().hasOnly(['sequence', 'status', 'driverUid', 'updatedAt'])) ||
              // Assigned driver updates stop progression & proof of delivery
              (get(/databases/$(database)/documents/deliveries/$(deliveryId)).data.driverUid == request.auth.uid
                && incoming().diff(existing()).affectedKeys().hasOnly(['driverUid', 'status', 'proofType', 'proofValue', 'proofNotes', 'updatedAt']))
            ))
          );
        allow delete: if isValidId(deliveryId) && isValidId(stopId) && isAdmin();
      }
    }

    // 11. Public Tracking (Isolated Single-Recipient View, Token Get Only, No List)
    match /publicTracking/{trackingToken} {
      allow get: if isValidId(trackingToken);
      allow list: if false;
      allow create: if isVerified() && isValidId(trackingToken)
        && isValidPublicTracking(incoming())
        && incoming().trackingToken == trackingToken
        && incoming().merchantUid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(trackingToken)
        && isValidPublicTracking(incoming())
        && incoming().trackingToken == existing().trackingToken
        && incoming().deliveryId == existing().deliveryId
        && incoming().stopId == existing().stopId
        && incoming().merchantUid == existing().merchantUid
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().merchantUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'driverUid', 'driverFirstName', 'showLiveDriver', 'updatedAt'])) ||
          (get(/databases/$(database)/documents/deliveries/$(existing().deliveryId)).data.driverUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['driverUid', 'driverFirstName', 'status', 'driverLat', 'driverLng', 'etaMinutes', 'showLiveDriver', 'updatedAt']))
        );
      allow delete: if isValidId(trackingToken) && isAdmin();
    }

    // 12. Scheduled Deliveries & Vehicle Reservations
    match /reservations/{reservationId} {
      allow get: if isValidId(reservationId) && isSignedIn()
        && (existing().merchantUid == request.auth.uid || existing().driverUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn()
        && (isBootstrapAdmin() || resource.data.merchantUid == request.auth.uid || resource.data.driverUid == request.auth.uid);
      allow create: if isVerified() && isValidId(reservationId) && isValidReservation(incoming())
        && incoming().merchantUid == request.auth.uid
        && incoming().status == 'pending_approval'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(reservationId) && isValidReservation(incoming())
        && incoming().merchantUid == existing().merchantUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (!(existing().status in ['completed', 'cancelled'])
            && existing().merchantUid == request.auth.uid
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isValidId(reservationId) && isAdmin();
    }

    // 13. Configurable Pricing Rules
    match /pricingRules/{ruleId} {
      allow get: if isValidId(ruleId) && isSignedIn();
      allow list: if isSignedIn() && (isBootstrapAdmin() || resource.data.active == true);
      allow create: if isValidId(ruleId) && isAdmin() && isValidPricingRule(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(ruleId) && isAdmin() && isValidPricingRule(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isValidId(ruleId) && isAdmin();
    }

    // 14. Operational Incidents & Support Tickets
    match /incidents/{incidentId} {
      allow get: if isValidId(incidentId) && isSignedIn() && (existing().reportedByUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isBootstrapAdmin() || resource.data.reportedByUid == request.auth.uid);
      allow create: if isVerified() && isValidId(incidentId) && isValidIncident(incoming())
        && incoming().reportedByUid == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(incidentId) && isValidIncident(incoming())
        && incoming().reportedByUid == existing().reportedByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin();
      allow delete: if isValidId(incidentId) && isAdmin();
    }

    // 15. Role-Scoped Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isBootstrapAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isVerified() && isValidId(notificationId) && isValidNotification(incoming())
        && incoming().createdAt == request.time
        && (
          incoming().userId == request.auth.uid
          || isAdmin()
          || (
            'deliveryId' in incoming()
            && isValidId(incoming().deliveryId)
            && exists(/databases/$(database)/documents/deliveries/$(incoming().deliveryId))
            && (
              get(/databases/$(database)/documents/deliveries/$(incoming().deliveryId)).data.merchantUid == request.auth.uid
              || get(/databases/$(database)/documents/deliveries/$(incoming().deliveryId)).data.driverUid == request.auth.uid
            )
          )
        );
      allow update: if isVerified() && isValidId(notificationId) && isValidNotification(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && (isAdmin() || (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read'])));
      allow delete: if isValidId(notificationId) && isAdmin();
    }

    // 16. Public Waitlist & Partner Inquiries
    match /waitlist/{entryId} {
      allow get: if isValidId(entryId) && isAdmin();
      allow list: if isBootstrapAdmin();
      allow create: if isValidId(entryId) && isValidWaitlist(incoming()) && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(entryId) && isAdmin();
    }

    // 17. Immutable Operational Audit Logs
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isBootstrapAdmin();
      allow create: if isVerified() && isValidId(logId) && isValidAuditLog(incoming())
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    // Connection test document read-only probe
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
