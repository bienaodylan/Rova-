# GEMINI_API_KEY: Optional Gemini API key injected by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where ROVA is hosted.
APP_URL="MY_APP_URL"

# Optional External Payment Provider Credentials (Server-side only — NEVER expose to browser)
PAYSTACK_SECRET_KEY=
MOMO_API_KEY=
STRIPE_SECRET_KEY=

# Google Maps Platform — Public Browser Key (Maps JavaScript API + Places API (New) only)
# Restrict in Google Cloud Console by HTTP Referrer (your domain) and API restrictions.
VITE_GOOGLE_MAPS_API_KEY=

# Google Maps Platform — Private Server Key (Geocoding API + Routes API v2 only)
# Server-side ONLY (never prefixed with VITE_, never sent to the browser).
# Restrict in Google Cloud Console by server IP / Cloud Run and API restrictions.
GOOGLE_MAPS_SERVER_API_KEY=

# Optional Geoapify public map tiles key (only if you prefer Geoapify over default CartoDB fallback)
VITE_GEOAPIFY_API_KEY=
