# GEMINI_API_KEY: Optional Gemini API key injected by AI Studio runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where ROVA is hosted.
APP_URL="MY_APP_URL"

# Optional External Payment Provider Credentials (Server-side only)
PAYSTACK_SECRET_KEY=
MOMO_API_KEY=
STRIPE_SECRET_KEY=

# Google Maps Platform API Key (injected automatically by AI Studio setup; restrict to HTTP referrers and required APIs)
VITE_GOOGLE_MAPS_API_KEY=

# Optional Geoapify public map tiles key (fallback when Google Maps key is absent)
VITE_GEOAPIFY_API_KEY=
