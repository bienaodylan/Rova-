# ============================================================================
# ROVA — VERCEL, SUPABASE & GOOGLE MAPS ENVIRONMENT VARIABLES
# ============================================================================
# Copy these keys into Vercel -> Project -> Settings -> Environment Variables
# (Production & Preview). NEVER commit real secret values into Git.

# ----------------------------------------------------------------------------
# 1. SUPABASE (Primary Production Backend on Vercel)
# ----------------------------------------------------------------------------
# Public Browser Credentials (safe for browser; protected by Supabase RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Private Server-Only Credentials (Vercel Serverless /api/v1/* ONLY — NEVER VITE_ prefixed)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# 2. GOOGLE MAPS PLATFORM
# ----------------------------------------------------------------------------
# Public Browser Key (Maps JavaScript API + Places API (New) ONLY)
# Restrict in Google Cloud Console by HTTP Referrer (https://*.vercel.app/*)
VITE_GOOGLE_MAPS_API_KEY=

# Private Server Key (Geocoding API + Routes API v2 ONLY — NEVER VITE_ prefixed)
GOOGLE_MAPS_SERVER_API_KEY=

# Optional Geoapify server key (never VITE_ prefixed) & optional tiles key
GEOAPIFY_API_KEY=
VITE_GEOAPIFY_API_KEY=

# ----------------------------------------------------------------------------
# 3. OPERATIONAL SECURITY, QUOTES, RECONCILIATION & NOTIFICATIONS (Server Only)
# ----------------------------------------------------------------------------
# HMAC secret (>= 32 chars) used to sign & verify authoritative server-side quotes
QUOTE_SIGNING_SECRET=

# Bearer secret (>= 32 chars) protecting Vercel Cron /api/v1/cron/reconcile
CRON_SECRET=

# Optional SMS / Push Notification Providers (Server Only — NEVER VITE_ prefixed)
SMS_PROVIDER_API_KEY=
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=

# ----------------------------------------------------------------------------
# 4. OPTIONAL PAYMENT GATEWAYS (Server-Side Only — NEVER VITE_ prefixed)
# ----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
MOMO_API_KEY=
STRIPE_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# 5. APPLICATION METADATA
# ----------------------------------------------------------------------------
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
