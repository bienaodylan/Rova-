{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user account with role and business linkage",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "role": {
          "type": "string",
          "enum": [
            "merchant",
            "business_owner",
            "business_employee",
            "independent_driver",
            "rova_driver",
            "fleet_partner",
            "fleet_manager",
            "recipient",
            "dispatcher",
            "operations_manager",
            "admin",
            "super_admin"
          ]
        },
        "businessId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Trusted administrator record for RBAC verification",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "level": { "type": "string", "enum": ["dispatcher", "operations_manager", "admin", "super_admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "level", "createdAt"]
    },
    "Business": {
      "title": "Business",
      "description": "Merchant or corporate business workspace",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "industry": { "type": "string", "maxLength": 80 },
        "city": { "type": "string", "minLength": 1, "maxLength": 100 },
        "country": { "type": "string", "minLength": 1, "maxLength": 80 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 8 },
        "verificationStatus": { "type": "string", "enum": ["pending", "verified", "suspended"] },
        "walletBalance": { "type": "number" },
        "defaultPickupAddress": { "type": "string", "maxLength": 300 },
        "defaultPickupLandmark": { "type": "string", "maxLength": 200 },
        "defaultPickupDigitalAddress": { "type": "string", "maxLength": 60 },
        "defaultPickupLat": { "type": "number" },
        "defaultPickupLng": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "city", "country", "currency", "verificationStatus", "walletBalance", "createdAt", "updatedAt"]
    },
    "BusinessMember": {
      "title": "BusinessMember",
      "description": "Team member invited to a business workspace",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "memberRole": { "type": "string", "enum": ["owner", "manager", "employee"] },
        "status": { "type": "string", "enum": ["invited", "active", "revoked"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "email", "name", "memberRole", "status", "createdAt"]
    },
    "SavedRecipient": {
      "title": "SavedRecipient",
      "description": "Saved recipient in a merchant address book",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
