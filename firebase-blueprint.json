        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fleetNumber", "registration", "category", "ownerType", "capacityKg", "status", "serviceArea", "maintenanceStatus", "brandingStatus", "createdAt", "updatedAt"]
    },
