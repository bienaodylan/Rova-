        "status": {
          "type": "string",
          "enum": [
            "pending",
            "scheduled",
            "driver_assigned",
            "driver_approaching_pickup",
            "at_pickup",
            "package_collected",
            "in_transit",
            "approaching_recipient",
            "arrived",
            "delivered",
            "failed",
            "rescheduled",
            "cancelled"
          ]
