        "totalDistanceKm": { "type": "number" },
        "estimatedDurationMin": { "type": "number" },
        "quotedPrice": { "type": "number" },
        "currency": { "type": "string", "minLength": 3, "maxLength": 8 },
        "paymentMethod": { "type": "string", "enum": ["mobile_money", "card", "invoice", "wallet"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "authorized", "paid", "invoiced", "refunded"] },
        "driverLat": { "type": "number" },
        "driverLng": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reference", "merchantUid", "merchantName", "driverUid", "vehicleCategory", "timingType", "pickupAddress", "pickupLat", "pickupLng", "packageType", "packageSize", "weightKg", "quantity", "fragile", "proofRequired", "status", "isMultiStop", "stopCount", "completedStopCount", "totalDistanceKm", "estimatedDurationMin", "quotedPrice", "currency", "paymentMethod", "paymentStatus", "createdAt", "updatedAt"]
    },
