        "currentLat": { "type": "number" },
        "currentLng": { "type": "number" },
        "rating": { "type": "number" },
        "completedDeliveries": { "type": "number" },
        "acceptanceRate": { "type": "number" },
        "activeDeliveryCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "firstName", "partnerType", "vehicleCategory", "serviceArea", "approvalStatus", "isOnline", "currentLat", "currentLng", "rating", "completedDeliveries", "acceptanceRate", "activeDeliveryCount", "updatedAt"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "ROVA fleet or partner vehicle record",
      "type": "object",
      "properties": {
        "fleetNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
        "registration": { "type": "string", "minLength": 2, "maxLength": 40 },
