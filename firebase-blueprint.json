        "partnerType": { "type": "string", "enum": ["independent", "rova_fleet", "fleet_partner", "commercial_partner"] },
        "vehicleCategory": { "type": "string", "enum": ["motorcycle", "cargo_motorcycle", "tricycle", "cargo_van", "commercial_van", "truck"] },
        "vehiclePlate": { "type": "string", "minLength": 2, "maxLength": 40 },
        "licenseNumber": { "type": "string", "minLength": 2, "maxLength": 80 },
        "insuranceRef": { "type": "string", "maxLength": 120 },
        "serviceArea": { "type": "string", "minLength": 1, "maxLength": 120 },
        "approvalStatus": { "type": "string", "enum": ["pending", "under_review", "approved", "suspended"] },
        "isOnline": { "type": "boolean" },
        "currentLat": { "type": "number" },
        "currentLng": { "type": "number" },
        "rating": { "type": "number" },
        "completedDeliveries": { "type": "number" },
        "acceptanceRate": { "type": "number" },
        "earningsTotal": { "type": "number" },
        "activeDeliveryCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "phone", "partnerType", "vehicleCategory", "vehiclePlate", "licenseNumber", "serviceArea", "approvalStatus", "isOnline", "rating", "completedDeliveries", "acceptanceRate", "earningsTotal", "activeDeliveryCount", "createdAt", "updatedAt"]
    },
    "DriverDispatch": {
      "title": "DriverDispatch",
      "description": "PII-free online driver dispatch index for real-time nearby driver matching",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "firstName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "partnerType": { "type": "string", "enum": ["independent", "rova_fleet", "fleet_partner", "commercial_partner"] },
        "vehicleCategory": { "type": "string", "enum": ["motorcycle", "cargo_motorcycle", "tricycle", "cargo_van", "commercial_van", "truck"] },
        "serviceArea": { "type": "string", "minLength": 1, "maxLength": 120 },
        "approvalStatus": { "type": "string", "enum": ["pending", "under_review", "approved", "suspended"] },
