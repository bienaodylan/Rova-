        "digitalAddress": { "type": "string", "maxLength": 60 },
        "instructions": { "type": "string", "maxLength": 300 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "name", "phone", "address", "lat", "lng", "createdAt"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Private driver profile, verification documents, and earnings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
